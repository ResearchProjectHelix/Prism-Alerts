# Same Supabase project the desktop PRISM app and old Expo app use.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public VAPID key for Web Push (generate with `npx web-push generate-vapid-keys`,
# or use the one printed when this project was scaffolded). Safe to expose publicly
# — the matching PRIVATE key must NEVER go here; it only lives in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
